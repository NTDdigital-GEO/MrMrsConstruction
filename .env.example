# Where images/videos load from. Leave unset: auto = local if public/wp-content/uploads exists, otherwise the live WP site.
# Set to a CDN (e.g. https://media.mrandmrscnr.com) if media is hosted on Cloudflare R2 / S3.
# PUBLIC_MEDIA_ORIGIN=

# Form endpoint. Default is the Cloudflare Pages Function in functions/api/lead.js.
# Can be replaced by Formspree / Basin / Zapier / HubSpot URL that accepts a JSON POST.
PUBLIC_FORM_ENDPOINT=/api/lead

# Cloudflare Turnstile site key (optional spam protection, replaces reCAPTCHA). Leave empty to rely on honeypot only.
PUBLIC_TURNSTILE_SITEKEY=

# --- Server-side (Cloudflare Pages > Settings > Environment variables), used by functions/api/lead.js ---
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/...   (CRM / Zapier / Make / HubSpot webhook)
# RESEND_API_KEY=re_...                           (send lead e-mails via resend.com)
# LEAD_TO_EMAIL=info@mrandmrscnr.com
# LEAD_FROM_EMAIL=leads@mrandmrscnr.com
# TURNSTILE_SECRET=

# --- Migration scripts ---
# WP_ORIGIN=https://mrandmrscnr.com   (must still be the WordPress site when you run npm run migrate / npm run media)
